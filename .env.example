# 수집기 환경변수 예시 — 복사해서 .env.local 로 사용 (GitHub Actions는 Secrets에 등록)
BLIZZARD_CLIENT_ID=
BLIZZARD_CLIENT_SECRET=
REGION=kr
GUILD_SLUG=같이와포하자

# 저장소: local(개발, public/data) | worker(운영, Worker 경유 R2) | r2(S3 API 직접, 예비)
STORAGE=local
LOCAL_DIR=public/data

# STORAGE=worker 일 때 (운영 기본)
WORKER_URL=https://wow-forever.wowak.workers.dev
INGEST_TOKEN=

# STORAGE=r2 일 때 (예비)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=wow-forever-data

# 1 이면 변경 여부 무시하고 전원 재수집
FORCE=0

# ── 사이트(Vercel) 환경변수 ──
# Worker 주소 (Update 버튼). 로컬은 http://localhost:8787 (cd worker && npx wrangler dev --local --port 8787)
NEXT_PUBLIC_API_BASE=
# 데이터·3D 주소 (비우면 로컬 기본값 /data, /mv)
# 운영 예: NEXT_PUBLIC_DATA_BASE=https://wow-forever.<계정>.workers.dev/forever/data
#          NEXT_PUBLIC_MODEL_BASE=https://wow-forever.<계정>.workers.dev/mv
NEXT_PUBLIC_DATA_BASE=
NEXT_PUBLIC_MODEL_BASE=
